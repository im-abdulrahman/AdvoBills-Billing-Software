<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginTop="5dp"
    android:background="@drawable/white_background"
    android:elevation="3dp"
    android:orientation="vertical"
    android:layout_marginBottom="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">


        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/UsersList_Image"
            app:shapeAppearanceOverlay="@style/Circular"
            android:layout_width="30dp"
            android:scaleType="centerCrop"
            android:layout_gravity="center"
            android:background="@color/secondary_color"
            android:layout_margin="10dp"
            android:layout_height="30dp"
            android:src="@mipmap/profile_icon"/>

        <TextView
            android:id="@+id/UsersList_Name"
            android:layout_gravity="center"
            android:gravity="left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:maxLines="1"
            android:textColor="@color/Dark_grey"
            android:padding="10dp"
            android:text=""/>


    </LinearLayout>

    <View
        android:id="@+id/divider_users_search_dialog01"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:visibility="gone"
        android:background="@color/view_color" />

    <LinearLayout
        android:id="@+id/layout_more_options_user_search"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/button_users_search_profile"
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:gravity="center"
            android:padding="10dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_baseline_person_account"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Profile"
                android:textSize="10dp"
                android:textColor="@color/light_grey"/>

        </LinearLayout>



        <LinearLayout
            android:id="@+id/button_users_search_chat"
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:gravity="center"
            android:padding="10dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_baseline_email_account"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Message"
                android:textSize="10dp"
                android:textColor="@color/light_grey"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/button_users_search_share"
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:gravity="center"
            android:padding="10dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_baseline_share_account"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Share"
                android:textSize="10dp"
                android:textColor="@color/light_grey"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
