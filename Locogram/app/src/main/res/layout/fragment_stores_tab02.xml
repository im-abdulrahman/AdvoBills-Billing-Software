<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".StoresTab02Fragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:orientation="vertical">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:background="@color/white"
                android:elevation="2dp"
                android:gravity="center"
                android:weightSum="3">

                <androidx.appcompat.widget.SearchView
                    android:id="@+id/searchView_userslist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="15dp"
                    android:theme="@style/SearchViewStyle"
                    app:defaultQueryHint="Search Users, Stores, Shops ...."
                    app:iconifiedByDefault="false"
                    android:background="@drawable/background_box_search"
                    app:searchHintIcon="@drawable/ic_baseline_search_grey"
                    app:searchIcon="@drawable/ic_baseline_search_grey" />

            </LinearLayout>

            <LinearLayout
                android:visibility="gone"
                android:id="@+id/empty_screen_followers_activity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="center"
                android:gravity="center">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginTop="20dp"
                    android:src="@mipmap/not_found"/>

                <TextView
                    android:id="@+id/empty_screen_TV_followers_activity"
                    android:layout_gravity="center"
                    android:textColor="@color/purple_200"
                    android:textStyle="bold"
                    android:textSize="15dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="alert text !"/>

            </LinearLayout>

        <LinearLayout
            android:id="@+id/followers_recycler_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/RecyclerView_users_show"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="5dp" />

        </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>