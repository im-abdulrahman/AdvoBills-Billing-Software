<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:elevation="3dp"
    android:background="@color/white">

    <LinearLayout
        android:background="@color/purple_200"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <TextView
            android:layout_gravity="center"
            android:id="@+id/TV_EditAlertBox"
            android:layout_width="match_parent"
            android:gravity="center"
            android:layout_height="wrap_content"
            android:text="Alert !"
            android:textColor="@color/white"
            android:textSize="15dp"
            android:textStyle="bold"
            android:layout_margin="10dp"/>

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/TextInputLayout_edit_profile"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="15dp"
            android:backgroundTint="#783E3E"
            android:hint="Enter text"
            android:textColorHint="@color/Dark_grey"
            app:boxBackgroundColor="@color/white"
            app:boxStrokeColor="@color/Dark_grey"
            app:counterEnabled="true"
            app:counterMaxLength="60"
            app:counterTextColor="@color/Dark_grey"
            app:endIconMode="clear_text"
            app:helperTextEnabled="true"
            app:helperTextTextAppearance="@style/MaterialAlertDialog.MaterialComponents.Title.Text.CenterStacked"
            app:helperTextTextColor="#FF0000"
            app:hintAnimationEnabled="true"
            app:hintEnabled="true"
            app:hintTextColor="@color/Dark_grey">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/TextInputEditText_edit_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter text"
                android:textColor="@color/black"
                android:textSize="12dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:gravity="center"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btn_cancel_changes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:layout_margin="10dp"
                android:textColor="@color/purple_200"
                android:textSize="10dp"
                android:backgroundTint="@color/white"/>

            <Button
                android:id="@+id/btn_save_changes"
                android:layout_margin="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save"
                android:textColor="@color/white"
                android:textSize="10dp"
                android:backgroundTint="@color/purple_200"/>

        </LinearLayout>
    </LinearLayout>

</LinearLayout>